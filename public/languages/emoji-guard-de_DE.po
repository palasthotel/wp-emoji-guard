#. translators: %s: the expected emojis
#: plugin.php:103
#, php-format
msgid ""
"Expected %s, but the stored value is missing or cannot be read - a migration"
" usually damaged it."
msgstr ""
"Erwartet: %s. Der gespeicherte Wert fehlt oder ist nicht lesbar - meist hat "
"ihn eine Migration beschädigt."

#. translators: 1: the expected emojis, 2: the emojis found in the database
#: plugin.php:109
#, php-format
msgid "Expected %1$s, found %2$s."
msgstr "Erwartet: %1$s, gefunden: %2$s."

#: plugin.php:121
msgid "Got the problem! Update validation option with valid emojis."
msgstr ""
"Das Problem ist behoben! Validierungsoption mit validen Emojis "
"aktualisieren."
